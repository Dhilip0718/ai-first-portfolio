# Copy this file to ".env.local" (with the leading dot) in the project root.
# Next.js does NOT load "env.local" — only .env.local

# Option A — Google AI (Gemini): use the key from Google AI Studio
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — override Gemini model (default: gemini-2.0-flash). If a model 404s, try:
# gemini-2.5-flash  |  gemini-2.0-flash-001  |  see https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-2.5-flash

# Option B — OpenAI (only if you use ChatGPT / OpenAI APIs)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# If BOTH are set, Google (Gemini) is used first.
